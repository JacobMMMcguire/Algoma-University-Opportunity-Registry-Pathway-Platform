DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
PORT=3001

# Comma-separated list of frontend origins allowed to make authenticated (cookie)
# requests to this API. Must match exactly (scheme + host + port), no trailing slash.
FRONTEND_ORIGINS=http://localhost:8080,https://your-project2-frontend.onrender.com

# Only email addresses ending in @<this domain> can request a sign-in challenge (R1-02).
ALLOWED_EMAIL_DOMAIN=algomau.ca
