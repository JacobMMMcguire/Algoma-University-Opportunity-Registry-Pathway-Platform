DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
PORT=3001

# Only email addresses ending in @<this domain> can request a sign-in challenge (R1-02).
ALLOWED_EMAIL_DOMAIN=algomau.ca

# Brevo transactional email. Email is only sent when both are set.
# EMAIL_FROM must be a sender address verified in your Brevo account.
BREVO_API_KEY=YOUR_BREVO_API_KEY
EMAIL_FROM=YOUR_VERIFIED_SENDER@example.com
EMAIL_FROM_NAME=Opportunity Registry

# "true" shows unused codes at /operator.html; "false" hides it. If unset, it is on
# only when email isn't configured.
SIGN_IN_TEST_MODE=
